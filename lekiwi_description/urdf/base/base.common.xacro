<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Color properties (RGBA) -->
  <xacro:property name="light_grey_rgba" value="0.8 0.8 0.8 1.0"/>
  <xacro:property name="charcoal_rgba" value="0.15 0.15 0.15 1.0"/>

  <!-- Base mesh rotation about Z (rad) -->
  <xacro:property name="base_offset_rz" value="${3*pi/2}"/>

  <!-- Common wheel geometry: used by ROS controllers, URDF and MuJoCo. -->
  <!-- Required input: base_controller_config:=/path/to/lekiwi_control/config/control.yaml.
       The launch/integration layer supplies it; description does not depend on control. -->
  <xacro:property name="base_geometry" value="${xacro.load_yaml('$(arg base_controller_config)')['base_controller']['ros__parameters']}"/>
  <xacro:property name="wheel_radius" value="${base_geometry['wheel_radius']}"/>
  <xacro:property name="offset" value="${base_geometry['wheel_offset']}"/>
  <!-- CAD wheel mesh radius in metres; a mesh reference measurement, not an operating parameter. -->
  <xacro:property name="wheel_mesh_radius" value="0.051"/>
  <xacro:property name="wheel_mesh_scale" value="${wheel_radius / wheel_mesh_radius}"/>
  <!-- Wheel mount offsets -->
  <xacro:property name="wheel_base_radius" value="${base_geometry['robot_radius']}"/>
  <xacro:property name="wheel_base_offset_z" value="0.01036"/>

  <!-- LD06 laser offsets from base_link -->
  <xacro:property name="laser_base_offset_x" value="-0.045042"/>
  <xacro:property name="laser_base_offset_z" value="0.0915"/>
  <xacro:property name="laser_offset_rx" value="${pi/2}"/>

  <!-- LDLidar frame offsets from laser_link -->
  <xacro:property name="laser_frame_offset_z" value="0.027"/>

  <!-- BNO055 IMU offsets from base_link -->
  <xacro:property name="imu_base_offset_x" value="-0.044"/>
  <xacro:property name="imu_base_offset_z" value="0.08"/>

  <!-- Respeaker flex mic offsets from base_link -->
  <xacro:property name="mic_base_offset_x" value="-0.045042"/>
  <xacro:property name="mic_base_offset_z" value="0.10901"/>

</robot>
