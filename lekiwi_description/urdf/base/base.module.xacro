<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find lekiwi_description)/urdf/base/base.common.xacro"/>

  <xacro:macro name="lekiwi_base_module" params="parent *origin">

    <!-- Material definitions (referenced by links below) -->
    <material name="base_light_grey">
      <color rgba="${light_grey_rgba}"/>
    </material>
    <material name="base_charcoal">
      <color rgba="${charcoal_rgba}"/>
    </material>

    <!-- Mount base_link to parent platform at specified origin -->
    <joint name="lekiwi_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Base link -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
        </geometry>
        <material name="base_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
      </inertial>
    </link>

    <!-- LD06 laser link -->
    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="${laser_offset_rx} 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/ld06_lidar.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${laser_offset_rx} 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/ld06_lidar.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Laser frame -->
    <link name="laser_frame"/>

    <!-- Gazebo simulation: LD19 lidar. update_rate/samples/angle/range values measured
         directly off the real robot's /scan topic, not the datasheet. gz_frame_id overrides
         gz-sim's default scoped sensor frame_id to the plain "laser_frame" the real
         ldlidar_ros2_node publishes, so TF resolves the same in sim as on hardware
         (unofficial SDF tag - gazebosim/gz-sensors#306). Inert outside Gazebo. -->
    <gazebo reference="laser_frame">
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>452</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.283185307179586</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <!-- BNO055 IMU link -->
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/bno055_imu.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/bno055_imu.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- IMU frame -->
    <link name="imu_frame"/>

    <!-- Gazebo simulation: BNO055 IMU. Attached to imu_frame and published on
         /imu_sensor_broadcaster/imu (imu_sensor_broadcaster's own topic/frame_id) so EKF
         needs no reconfiguration between real and sim; imu_sensor_broadcaster itself isn't
         spawned in gazebo mode to avoid racing with this bridged topic. update_rate=50
         matches controller_manager's rate. Noise stddevs are sqrt() of
         imu_sensor_broadcaster's static_covariance_* params (gz has no separate orientation
         noise, so orientation comes out noise-free). gz_frame_id/inertness: see lidar above. -->
    <gazebo reference="imu_frame">
      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>imu_sensor_broadcaster/imu</topic>
        <gz_frame_id>imu_frame</gz_frame_id>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00316</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00316</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00316</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01414</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01414</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01414</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- Respeaker flex mic link -->
    <link name="mic_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/respeaker_flex_mic.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/respeaker_flex_mic.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Left wheel link -->
    <link name="left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Back wheel link -->
    <link name="back_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Right wheel link -->
    <link name="right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- JOINTS -->

    <!-- laser fixed joint -->
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="${laser_base_offset_x} 0 ${laser_base_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- laser_frame fixed joint -->
    <joint name="laser_frame_joint" type="fixed">
      <parent link="laser_link"/>
      <child link="laser_frame"/>
      <origin xyz="0 0 ${laser_frame_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- IMU fixed joint -->
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_base_offset_x} 0 ${imu_base_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- imu_frame fixed joint -->
    <joint name="imu_frame_joint" type="fixed">
      <parent link="imu_link"/>
      <child link="imu_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Respeaker flex mic fixed joint -->
    <joint name="mic_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mic_link"/>
      <origin xyz="${mic_base_offset_x} 0 ${mic_base_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- left wheel joint: 60 degrees anti-clockwise from +X at radius wheel_base_radius -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset)} ${wheel_base_radius * sin(offset)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

    <!-- back wheel joint: 180 degrees anti-clockwise from +X at radius base_radius -->
    <joint name="back_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="back_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset + theta)} ${wheel_base_radius * sin(offset + theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset + theta}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

    <!-- right wheel joint: 300 degrees (or -60 degrees) anti-clockwise from +X at radius base_radius -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset - theta)} ${wheel_base_radius * sin(offset - theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset - theta}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

  </xacro:macro>

</robot>
