<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find lekiwi_description)/urdf/base/base.common.xacro"/>

  <xacro:macro name="lekiwi_base_module" params="parent *origin">

    <!-- Material definitions (referenced by links below) -->
    <material name="base_light_grey">
      <color rgba="${light_grey_rgba}"/>
    </material>
    <material name="base_charcoal">
      <color rgba="${charcoal_rgba}"/>
    </material>

    <!-- Mount base_link to parent platform at specified origin -->
    <joint name="lekiwi_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Base link -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
        </geometry>
        <material name="base_light_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
      </inertial>
    </link>

    <!-- LD06 laser link -->
    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="${laser_offset_rx} 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/ld06_lidar.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${laser_offset_rx} 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/ld06_lidar.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Laser frame -->
    <link name="laser_frame"/>

    <!-- Gazebo simulation: LD19 lidar, values measured directly off the real robot
         (ros2 launch lekiwi_bringup laser.launch.py, then `ros2 topic hz /scan` and
         echoing individual messages) rather than the datasheet:
           - update_rate=10: measured /scan rate was a steady 10.00-10.01 Hz.
           - samples=452: angle_increment measured ~0.0139 rad/point average across
             several messages; 2*pi/0.0139 ~= 452. (The real driver actually publishes
             partial ~129-point slices per message rather than one full 452-point sweep -
             that's a chunking quirk of ldlidar_ros2_node's publishing, not something
             SLAM/Nav2 depend on, so it's not replicated here; a clean full sweep at the
             same angular resolution is the right target.)
           - min_angle/max_angle=0..2pi and range 0.02-12m: read directly off the real
             /scan message fields (angle_min/angle_max/range_min/range_max).
         gz_frame_id overrides gz-sim's default scoped sensor frame_id
         (e.g. lekiwi/laser_frame/lidar) to the plain "laser_frame" the real
         ldlidar_ros2_node publishes (lekiwi_bringup/config/laser.yaml), so TF lookups
         resolve the same way in sim as on hardware - unofficial SDF tag (emits a
         "not defined in SDF" warning) but functional: gazebosim/gz-sensors#306.
         nav2/slam_toolbox's own range caps (obstacle_max_range: 5.5, max_laser_range:
         8.0) are intentionally below this sensor's 12m max, same as with the real LD19.
         Inert outside Gazebo, like the <gazebo> control plugin in base.urdf.xacro. -->
    <gazebo reference="laser_frame">
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>452</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.283185307179586</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <!-- BNO055 IMU link -->
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/bno055_imu.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/bno055_imu.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- IMU frame -->
    <link name="imu_frame"/>

    <!-- Gazebo simulation: BNO055 IMU. Matches imu_sensor_broadcaster's frame_id
         (lekiwi_control/config/base/control.yaml: frame_id=imu_frame) by attaching
         directly to the imu_frame link, and topic is set to the exact topic name
         imu_sensor_broadcaster would publish on (/imu_sensor_broadcaster/imu) so EKF
         (lekiwi_navigation/config/robot_localization/ekf*.yaml: imu0) needs no
         reconfiguration between real and sim. Because of this, imu_sensor_broadcaster
         itself is NOT spawned in gazebo mode (control.launch.py) - it would otherwise
         publish the mock bno055_hardware_interface's fake static data onto the same
         topic, racing with this bridged one. update_rate=50 matches controller_manager's
         update_rate (lekiwi_control/config/base/control.yaml) - the effective rate
         imu_sensor_broadcaster publishes at on real hardware regardless of the BNO055's
         own internal fusion rate. angular_velocity/linear_acceleration noise stddev
         values are sqrt() of imu_sensor_broadcaster's static_covariance_* parameters
         (same yaml file) - gz's IMU sensor has no equivalent independent orientation
         noise parameter, so orientation comes out physics-consistent/noise-free instead.
         gz_frame_id and inertness outside Gazebo: see the lidar sensor above. -->
    <gazebo reference="imu_frame">
      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>imu_sensor_broadcaster/imu</topic>
        <gz_frame_id>imu_frame</gz_frame_id>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00316</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00316</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00316</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01414</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01414</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01414</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- Respeaker flex mic link -->
    <link name="mic_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/respeaker_flex_mic.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/respeaker_flex_mic.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Left wheel link -->
    <link name="left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Back wheel link -->
    <link name="back_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Right wheel link -->
    <link name="right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
        <material name="base_charcoal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- JOINTS -->

    <!-- laser fixed joint -->
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="${laser_base_offset_x} 0 ${laser_base_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- laser_frame fixed joint -->
    <joint name="laser_frame_joint" type="fixed">
      <parent link="laser_link"/>
      <child link="laser_frame"/>
      <origin xyz="0 0 ${laser_frame_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- IMU fixed joint -->
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_base_offset_x} 0 ${imu_base_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- imu_frame fixed joint -->
    <joint name="imu_frame_joint" type="fixed">
      <parent link="imu_link"/>
      <child link="imu_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Respeaker flex mic fixed joint -->
    <joint name="mic_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mic_link"/>
      <origin xyz="${mic_base_offset_x} 0 ${mic_base_offset_z}" rpy="0 0 0"/>
    </joint>

    <!-- left wheel joint: 60 degrees anti-clockwise from +X at radius wheel_base_radius -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset)} ${wheel_base_radius * sin(offset)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

    <!-- back wheel joint: 180 degrees anti-clockwise from +X at radius base_radius -->
    <joint name="back_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="back_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset + theta)} ${wheel_base_radius * sin(offset + theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset + theta}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

    <!-- right wheel joint: 300 degrees (or -60 degrees) anti-clockwise from +X at radius base_radius -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset - theta)} ${wheel_base_radius * sin(offset - theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset - theta}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

  </xacro:macro>

</robot>
