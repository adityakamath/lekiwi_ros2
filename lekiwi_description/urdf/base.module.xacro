<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find lekiwi_description)/urdf/base.common.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/ld06.module.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/bno055.module.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/respeaker.module.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/vl53l5cx.module.xacro"/>

  <!-- Split CAD components retain the base mesh origin and orientation.
       Their mass remains included in base_link's lumped inertial estimate. -->
  <xacro:macro name="lekiwi_base_component" params="name mesh material rgba offset_z:=0">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/${mesh}.stl"/>
        </geometry>
        <material name="${material}"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/${mesh}.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 ${offset_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="lekiwi_base_module" params="parent *origin">

    <!-- Material definitions (referenced by links below) -->
    <material name="base_light_grey">
      <color rgba="${light_grey_rgba}"/>
    </material>
    <material name="base_charcoal">
      <color rgba="${charcoal_rgba}"/>
    </material>

    <!-- Mount base_link to parent platform at specified origin -->
    <joint name="lekiwi_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Base link -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
        </geometry>
        <material name="base_light_grey"><color rgba="${light_grey_rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/lekiwi_base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
      </inertial>
    </link>

    <!-- Raspberry Pi 5 case (alternative computers can add their own assembly) -->
    <xacro:if value="${has_rpi5}">
      <xacro:lekiwi_base_component name="rpi5_case" mesh="rpi5_case_assembly"
                                   material="base_light_grey" rgba="${light_grey_rgba}"/>
    </xacro:if>

    <!-- Gemini 2 base mount -->
    <xacro:if value="${has_gemini2}">
      <xacro:lekiwi_base_component name="gemini2_mount" mesh="gemini2_mount"
                                   offset_z="${gemini2_mount_base_offset_z}"
                                   material="base_light_grey" rgba="${light_grey_rgba}"/>
    </xacro:if>

    <!-- Shared LiDAR/SparkFun mount; stays while either sensor is fitted. -->
    <xacro:if value="${has_lidar or has_sparkfun_sensor}">
      <xacro:lekiwi_base_component name="lidar_plate" mesh="lidar_plate_assembly"
                                   material="base_light_grey" rgba="${light_grey_rgba}"/>
    </xacro:if>
    <xacro:if value="${has_lidar}">
      <xacro:lekiwi_ld06_module/>
    </xacro:if>
    <!-- reSpeaker, control board, speaker and mounts -->
    <xacro:if value="${has_respeaker}">
      <xacro:lekiwi_respeaker_module/>
    </xacro:if>

    <!-- SparkFun sensor and mounting plate -->
    <xacro:if value="${has_sparkfun_sensor}">
      <xacro:lekiwi_vl53l5cx_module/>
    </xacro:if>

    <!-- Shelf and spacers -->
    <xacro:if value="${has_shelf}">
      <!-- Spacers between the chassis and the tray -->
      <xacro:lekiwi_base_component name="shelf_spacers" mesh="shelf_spacers_35mm"
                                   material="base_light_grey" rgba="${light_grey_rgba}"/>

      <!-- Tray (same CAD frame as lekiwi_base.stl) -->
      <link name="tray_link">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
          <geometry>
            <mesh filename="package://lekiwi_description/meshes/shelf_tray.stl"/>
          </geometry>
          <material name="base_charcoal"><color rgba="${charcoal_rgba}"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
          <geometry>
            <mesh filename="package://lekiwi_description/meshes/shelf_tray.stl"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="0.05"/>
          <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
      </link>

      <!-- tray fixed joint -->
      <joint name="tray_joint" type="fixed">
        <parent link="base_link"/>
        <child link="tray_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <!-- BNO055 IMU -->
    <xacro:if value="${has_imu}">
      <xacro:lekiwi_bno055_module/>
    </xacro:if>
    <!-- Left wheel link -->
    <link name="left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl" scale="${wheel_mesh_scale} ${wheel_mesh_scale} ${wheel_mesh_scale}"/>
        </geometry>
        <material name="base_charcoal"><color rgba="${charcoal_rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl" scale="${wheel_mesh_scale} ${wheel_mesh_scale} ${wheel_mesh_scale}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Back wheel link -->
    <link name="back_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl" scale="${wheel_mesh_scale} ${wheel_mesh_scale} ${wheel_mesh_scale}"/>
        </geometry>
        <material name="base_charcoal"><color rgba="${charcoal_rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl" scale="${wheel_mesh_scale} ${wheel_mesh_scale} ${wheel_mesh_scale}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Right wheel link -->
    <link name="right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl" scale="${wheel_mesh_scale} ${wheel_mesh_scale} ${wheel_mesh_scale}"/>
        </geometry>
        <material name="base_charcoal"><color rgba="${charcoal_rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lekiwi_description/meshes/omni_wheel.stl" scale="${wheel_mesh_scale} ${wheel_mesh_scale} ${wheel_mesh_scale}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <!-- JOINTS -->

    <!-- left wheel joint: 60 degrees anti-clockwise from +X at radius wheel_base_radius -->
    <joint name="left_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="left_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset)} ${wheel_base_radius * sin(offset)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

    <!-- back wheel joint: 180 degrees anti-clockwise from +X at radius base_radius -->
    <joint name="back_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="back_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset + theta)} ${wheel_base_radius * sin(offset + theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset + theta}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

    <!-- right wheel joint: 300 degrees (or -60 degrees) anti-clockwise from +X at radius base_radius -->
    <joint name="right_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="right_wheel_link"/>
      <origin xyz="${wheel_base_radius * cos(offset - theta)} ${wheel_base_radius * sin(offset - theta)} ${wheel_base_offset_z}" rpy="0 ${pi/2} ${offset - theta}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${max_torque_nm}" velocity="${max_velocity_rads}"/>
    </joint>

  </xacro:macro>

</robot>
