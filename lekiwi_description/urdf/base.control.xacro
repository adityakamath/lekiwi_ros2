<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments (externally settable via command line) -->
  <xacro:arg name="serial_port"  default="/dev/ttySERVO"/>
  <xacro:arg name="baud_rate"    default="1000000"/>
  <xacro:arg name="use_mock"     default="false"/>
  <xacro:arg name="use_sync_write" default="true"/>
  <xacro:arg name="i2c_bus"      default="1"/>
  <xacro:arg name="i2c_addr"     default="28"/>
  <xacro:arg name="axis_remap"   default="P1"/>
  <xacro:arg name="sensor_mode"  default="NDOF"/>
  <xacro:arg name="use_pantilt" default="false"/>

  <!-- Base motor IDs and mode -->
  <xacro:property name="left_motor_id" value="7"/>
  <xacro:property name="back_motor_id" value="8"/>
  <xacro:property name="right_motor_id" value="9"/>
  <xacro:property name="base_operating_mode" value="1"/>  <!-- Velocity mode -->

  <!-- Pan-tilt motor IDs and mode (when use_pantilt:=true) -->
  <xacro:property name="pan_motor_id" value="1"/>
  <xacro:property name="tilt_motor_id" value="2"/>
  <xacro:property name="pantilt_operating_mode" value="0"/>  <!-- Position mode -->

  <!-- Pan and tilt joint limits -->
  <xacro:property name="pan_joint_lower" value="-2"/>
  <xacro:property name="pan_joint_upper" value="2"/>
  <xacro:property name="tilt_joint_lower" value="${-pi/2}"/>
  <xacro:property name="tilt_joint_upper" value="${pi/2}"/>

  <!-- Motor-specific parameter (STS3215 default) -->
  <!-- Adjust for other motor models: STS3032 max=2900, STS3235 max=3400 -->
  <xacro:property name="sts_max_velocity_steps" value="3400"/>  <!-- Max hardware velocity in steps/s (absolute motor limit, do not exceed) -->

  <!-- Proportional ACC parameters (SyncWriteSpe velocity path only) -->
  <!-- ACC given to the wheel with the largest |target - current| velocity delta. -->
  <!-- All others scaled proportionally so every wheel finishes ramping in equal time. -->
  <!-- Set proportional_acc_max to 0 to disable (ACC=0 for all wheels). -->
  <xacro:property name="proportional_acc_max" value="25"/>        <!-- [0-254] -->

  <!-- Wheel geometry for omnidirectional control -->
  <xacro:property name="wheel_radius" value="0.051"/>  <!-- meters -->
  <xacro:property name="offset" value="${pi/3}"/>  <!-- 60° -->
  <xacro:property name="theta" value="${2*pi/3}"/>  <!-- 120° between wheels -->

  <!-- Maximum allowable speed/acceleration/torque for each motor -->
  <xacro:property name="max_velocity_steps" value="${int(sts_max_velocity_steps * 0.85)}"/> <!-- steps/second (85% of hardware max, 15% safety margin) -->
  <xacro:property name="max_velocity_rads" value="${max_velocity_steps*2*pi/4096}"/> <!-- rad/s -->
  <xacro:property name="max_torque_nm" value="2.942"/> <!-- N⋅m (30 kgf⋅cm for STS3215) -->

  <!-- Omnidirectional Kinematics Calculations -->
  <!-- For 3-wheel omni drive: ω_i = (-sin(θ_i)·v_x + cos(θ_i)·v_y + R·ω_z) / r -->

  <!-- Maximum allowable linear velocity per axis -->
  <xacro:property name="max_linear_velocity_x" value="${wheel_radius * max_velocity_rads / (sqrt(3)/2)}"/>
  <xacro:property name="max_linear_velocity_y" value="${wheel_radius * max_velocity_rads / 1.0}"/>

  <!-- ROS 2 CONTROL -->
  <!-- System interface (STS motors) -->
  <ros2_control name="lekiwi_base" type="system">
    <hardware>
      <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
      <!-- Serial communication parameters -->
      <param name="serial_port">$(arg serial_port)</param>
      <param name="baud_rate">$(arg baud_rate)</param>
      <param name="use_sync_write">$(arg use_sync_write)</param>
      <param name="enable_mock_mode">$(arg use_mock)</param>
      <!-- Motor-specific parameter (adjust for different STS motor models) -->
      <param name="max_velocity_steps">${sts_max_velocity_steps}</param>
      <!-- Proportional ACC: scale per-wheel acceleration so all wheels finish ramping in equal time -->
      <param name="proportional_acc_max">${proportional_acc_max}</param>
    </hardware>
    <!-- Left wheel joint (Motor ID 7) -->
    <joint name="left_wheel_joint">
      <param name="motor_id">${left_motor_id}</param>
      <param name="operating_mode">${base_operating_mode}</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="current"/>
      <state_interface name="is_moving"/>
    </joint>
    <!-- Back wheel joint (Motor ID 8) -->
    <joint name="back_wheel_joint">
      <param name="motor_id">${back_motor_id}</param>
      <param name="operating_mode">${base_operating_mode}</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="current"/>
      <state_interface name="is_moving"/>
    </joint>
    <!-- Right wheel joint (Motor ID 9) -->
    <joint name="right_wheel_joint">
      <param name="motor_id">${right_motor_id}</param>
      <param name="operating_mode">${base_operating_mode}</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="current"/>
      <state_interface name="is_moving"/>
    </joint>

    <!-- Pan and tilt joints (when use_pantilt:=true, shares same hardware interface) -->
    <xacro:if value="$(arg use_pantilt)">
      <!-- Pan axis: rotates the payload around Z (Motor ID 1) -->
      <joint name="pan_joint">
        <param name="motor_id">${pan_motor_id}</param>
        <param name="operating_mode">${pantilt_operating_mode}</param>
        <param name="min_position">${pan_joint_lower}</param>
        <param name="max_position">${pan_joint_upper}</param>
        <param name="max_velocity">${max_velocity_rads}</param>
        <param name="position_center_steps">2048</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </joint>

      <!-- Tilt axis: rotates the payload around Y (Motor ID 2) -->
      <joint name="tilt_joint">
        <param name="motor_id">${tilt_motor_id}</param>
        <param name="operating_mode">${pantilt_operating_mode}</param>
        <param name="min_position">${tilt_joint_lower}</param>
        <param name="max_position">${tilt_joint_upper}</param>
        <param name="max_velocity">${max_velocity_rads}</param>
        <param name="position_center_steps">2048</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </joint>
    </xacro:if>
  </ros2_control>

  <!-- ROS 2 CONTROL -->
  <!-- Sensor interface (BNO055 IMU) -->
  <ros2_control name="lekiwi_imu" type="sensor">
    <hardware>
      <plugin>bno055_hardware_interface/BNO055HardwareInterface</plugin>
      <param name="i2c_bus">$(arg i2c_bus)</param>       <!-- I2C bus number (default: 1 → /dev/i2c-1) -->
      <param name="i2c_addr">$(arg i2c_addr)</param>     <!-- I2C address in hex, no 0x prefix (default: 28 = 0x28) -->
      <param name="axis_remap">$(arg axis_remap)</param> <!-- Axis placement config: P0-P7 (default: P1) -->
      <param name="sensor_mode">$(arg sensor_mode)</param> <!-- Fusion mode: NDOF, NDOF_FMC_OFF, IMUPLUS (default: NDOF) -->
      <param name="enable_mock_mode">$(arg use_mock)</param>  <!-- Reuse the system-level mock flag -->
    </hardware>
    <sensor name="bno055">
      <!-- Orientation (quaternion, unit norm) -->
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <!-- Angular velocity (rad/s) -->
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <!-- Linear acceleration (m/s²), gravity-compensated -->
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>

</robot>
