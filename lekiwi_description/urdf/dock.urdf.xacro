<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi_dock">

  <xacro:include filename="$(find lekiwi_description)/urdf/base.common.xacro"/>

  <!-- Dock-side connector. The mesh shares the base CAD origin, so dock_link coincides with base_link
       when docked; place the dock in the world by the pose of dock_link. -->
  <link name="dock_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/dock_connector_station.stl"/>
      </geometry>
      <material name="dock_charcoal"><color rgba="${charcoal_rgba}"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://lekiwi_description/meshes/dock_connector_station.stl"/>
      </geometry>
    </collision>
  </link>

</robot>
