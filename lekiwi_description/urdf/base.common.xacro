<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One hardware file is shared by bringup, URDF and simulation. -->
  <!-- The integration layer passes hardware_config; this package owns no robot profile. -->
  <xacro:property name="hardware" value="${xacro.load_yaml('$(arg hardware_config)')}"/>
  <xacro:property name="has_lidar" value="${hardware.get('lidar', True)}"/>
  <xacro:property name="has_imu" value="${hardware.get('imu', True)}"/>
  <xacro:property name="has_rpi5" value="${hardware.get('rpi5', True)}"/>
  <xacro:property name="has_respeaker" value="${hardware.get('respeaker', True)}"/>
  <xacro:property name="has_sparkfun_sensor" value="${hardware.get('sparkfun_sensor', True)}"/>
  <xacro:property name="has_gemini2" value="${hardware.get('gemini2', True)}"/>
  <xacro:property name="has_shelf" value="${hardware.get('shelf', True)}"/>



  <!-- Color properties (RGBA) -->
  <xacro:property name="light_grey_rgba" value="0.8 0.8 0.8 1.0"/>
  <xacro:property name="charcoal_rgba" value="0.15 0.15 0.15 1.0"/>

  <!-- Base mesh rotation about Z (rad) -->
  <xacro:property name="base_offset_rz" value="${3*pi/2}"/>

  <!-- Common wheel geometry: used by ROS controllers, URDF and MuJoCo. -->
  <!-- Required input: base_controller_config:=/path/to/lekiwi_control/config/control.yaml.
       The launch/integration layer supplies it; description does not depend on control. -->
  <xacro:property name="base_geometry" value="${xacro.load_yaml('$(arg base_controller_config)')['base_controller']['ros__parameters']}"/>
  <xacro:property name="wheel_radius" value="${base_geometry['wheel_radius']}"/>
  <xacro:property name="offset" value="${base_geometry['wheel_offset']}"/>
  <!-- CAD wheel mesh radius in metres; a mesh reference measurement, not an operating parameter. -->
  <xacro:property name="wheel_mesh_radius" value="0.051"/>
  <xacro:property name="wheel_mesh_scale" value="${wheel_radius / wheel_mesh_radius}"/>
  <!-- Wheel mount offsets -->
  <xacro:property name="wheel_base_radius" value="${base_geometry['robot_radius']}"/>
  <xacro:property name="wheel_base_offset_z" value="0.01036"/>

  <!-- Seat the mount's CAD underside (59.5 mm) on the base upper plate (52.5 mm). -->
  <xacro:property name="gemini2_mount_base_offset_z" value="-0.007"/>

  <!-- Static Gemini 2  on the base's front bracket, from the Gemini 2 mount: the bracket's
       front face is at x=75 mm with two 2.7 mm holes 45 mm apart at z=72.3 mm, the camera mounting pattern. gemini2_link sits 18.65 mm ahead of the rear (seat) face. -->
  <xacro:property name="gemini2_base_offset_x" value="0.09365"/>
  <xacro:property name="gemini2_base_offset_z" value="0.0723"/>

  <!-- LD06 laser offsets from base_link -->
  <xacro:property name="laser_base_offset_x" value="-0.045042"/>
  <xacro:property name="laser_base_offset_z" value="0.0915"/>
  <xacro:property name="laser_offset_rx" value="${pi/2}"/>

  <!-- LDLidar frame offsets from laser_link -->
  <xacro:property name="laser_frame_offset_z" value="0.027"/>

  <!-- BNO055 IMU offsets from base_link -->
  <xacro:property name="imu_base_offset_x" value="-0.044"/>
  <xacro:property name="imu_base_offset_z" value="0.08"/>

  <!-- Respeaker flex mic offsets from base_link -->
  <xacro:property name="mic_base_offset_x" value="-0.045042"/>
  <xacro:property name="mic_base_offset_z" value="0.10901"/>

  <!-- Dock connector contact face in base_link (mesh y=+106.8 mm rotated onto +x; contact tip z=10.2 mm) -->
  <xacro:property name="dock_connector_frame_offset_x" value="0.1068"/>
  <xacro:property name="dock_connector_frame_offset_z" value="0.0102"/>

  <!-- SparkFun VL53L5CX ToF on the base's mid-plate holder pad (pad top z=95.5 mm, centre x=-40 mm, y=+70 mm).
       The mesh origin is its corner, so the origin is the centre shifted by (12.7, 12.7) mm; yaw pi puts the
       7-pad header toward +y and the Qwiic connectors on +/-x. -->
  <xacro:property name="tof_base_offset_x" value="-0.0273"/>
  <xacro:property name="tof_base_offset_y" value="0.0827"/>
  <xacro:property name="tof_base_offset_z" value="0.0955"/>
  <xacro:property name="tof_offset_rz" value="${pi}"/>
  <!-- tof_frame: the chip's top-face centre in tof_link; +z is the boresight tof_imager_ros ranges along. The yaw
       turns the driver's pixel axes onto the robot's: measured by moving a sheet from the back to the front of the
       robot, which the cloud showed moving from the robot's left to its right. This leaves +x to the robot's right and
       +y forward. -->
  <xacro:property name="tof_frame_offset_x" value="0.0127"/>
  <xacro:property name="tof_frame_offset_y" value="0.0127"/>
  <xacro:property name="tof_frame_offset_z" value="0.0031"/>
  <xacro:property name="tof_frame_offset_rz" value="${pi/2}"/>

</robot>
