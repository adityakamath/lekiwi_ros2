<?xml version="1.0"?>
<robot name="pantilt" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find lekiwi_description)/urdf/pantilt/pantilt.common.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/pantilt/pantilt.control.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/pantilt/pantilt.module.xacro"/>

  <link name="base_footprint"/>

  <xacro:pantilt_module parent="base_footprint">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:pantilt_module>

</robot>
