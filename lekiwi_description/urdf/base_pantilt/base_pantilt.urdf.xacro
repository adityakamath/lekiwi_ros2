<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">

  <xacro:include filename="$(find lekiwi_description)/urdf/base_pantilt/base_pantilt.common.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/base_pantilt/base_pantilt.control.xacro"/>
  <xacro:include filename="$(find lekiwi_description)/urdf/base/base.module.xacro"/>
  <xacro:include filename="$(find pt_description)/urdf/pantilt.module.xacro"/>

  <link name="base_footprint"/>

  <xacro:lekiwi_base_module parent="base_footprint">
    <origin xyz="0 0 ${wheel_radius - wheel_base_offset_z}" rpy="0 0 0"/>
  </xacro:lekiwi_base_module>

  <xacro:pantilt_module parent="base_link">
    <origin xyz="${pantilt_base_offset_x} 0 ${pantilt_base_offset_z}" rpy="0 0 0"/>
  </xacro:pantilt_module>

  <!-- Gazebo simulation: spawns controller_manager inside the gz_sim process, loading
       both $(arg simulation_controllers) (base) and $(arg payload_simulation_controllers)
       (pantilt) - gz_ros2_control's <parameters> tag can be given multiple times and
       controller_manager merges them, same as the real robot's standalone
       ros2_control_node merges base/control.yaml + payloads/pantilt/control.yaml.
       Inert (ignored) outside Gazebo, so this is safe to leave in place regardless of
       ros2_control_hardware_type. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <parameters>$(arg payload_simulation_controllers)</parameters>
    </plugin>
  </gazebo>

</robot>
