<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments (externally settable via command line or parent xacro) -->
  <xacro:arg name="serial_port" default="/dev/ttySERVO"/>
  <xacro:arg name="baud_rate" default="1000000"/>
  <xacro:arg name="use_mock" default="false"/>
  <xacro:arg name="use_sync_write" default="true"/>
  <xacro:arg name="left_motor_id" default="7"/>
  <xacro:arg name="back_motor_id" default="8"/>
  <xacro:arg name="right_motor_id" default="9"/>
  <xacro:arg name="internal_max_vel" default="254"/>
  <xacro:arg name="internal_max_acc" default="254"/>
  <xacro:arg name="internal_acc_coeff" default="254"/>
  <!-- Pan/tilt motor IDs, step-centering, and joint limits are NOT args here - they're
       pt_description's own physical-calibration constants, baked into pantilt.joints.xacro's
       macro defaults (single source of truth - see that file and pantilt.control.xacro's
       matching comment). Override them explicitly on the <xacro:pantilt_joints> call below
       only if this specific unit is ever calibrated differently from pt_description's
       defaults. -->

  <!-- BNO055 IMU parameters (externally settable) -->
  <xacro:arg name="imu"             default="true"/>    <!-- false = no physical IMU; omits the lekiwi_imu sensor block below (real hardware only) -->
  <xacro:arg name="imu_i2c_bus"     default="1"/>       <!-- I2C bus number (/dev/i2c-1) -->
  <xacro:arg name="imu_i2c_addr"    default="28"/>      <!-- I2C address: 28 = 0x28 (ADR pin low) -->
  <xacro:arg name="imu_axis_remap"  default="P1"/>      <!-- Mounting orientation P0-P7, see BNO055 datasheet Table 3-4 -->
  <xacro:arg name="imu_sensor_mode" default="NDOF"/>    <!-- Fusion mode: NDOF, NDOF_FMC_OFF, IMUPLUS -->

  <!-- Configurable hardware parameters (STS3215 defaults) -->
  <xacro:arg name="sts3215_max_vel_steps" default="3400"/>  <!-- STS3215=3400, STS3032=2900, STS3235=3400 -->
  <xacro:arg name="proportional_acc_max"   default="25"/>    <!-- [0-254]; 0 = disable proportional ACC -->
  <xacro:arg name="proportional_vel_max"   default="0"/>     <!-- [0-max_velocity_steps]; 0 = each joint uses commanded velocity -->

  <!-- Simulation -->
  <!-- "real" (default): STS3215 serial plugin. "mujoco": MujocoSystemInterface, driving
       wheels+pan/tilt and hosting IMU/lidar below, wired into control.launch.py. "gazebo": GazeboSimSystem, xacro-only. -->
  <xacro:arg name="ros2_control_hardware_type" default="real"/>
  <!-- Two separate controllers-YAML args (sim only): gz_ros2_control merges multiple
       <parameters> tags, matching control.launch.py's real base+payload split. -->
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="payload_simulation_controllers" default=""/>
  <!-- MJCF scene path and headless flag; only used when ros2_control_hardware_type:="mujoco". -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="mujoco_headless" default="false"/>

  <!-- Base operating mode -->
  <xacro:property name="base_operating_mode" value="1"/>  <!-- Velocity mode -->

  <!-- Motor-specific parameter — sourced from arg, STS3215 default -->
  <xacro:property name="sts3215_max_vel_steps" value="$(arg sts3215_max_vel_steps)"/>  <!-- Max hardware velocity in steps/s -->

  <!-- Proportional ACC parameters (SyncWriteSpe velocity path only) -->
  <!-- ACC given to the wheel with the largest |target - current| velocity delta. -->
  <!-- All others scaled proportionally so every wheel finishes ramping in equal time. -->
  <!-- Set proportional_acc_max to 0 to disable (ACC=0 for all wheels). -->
  <xacro:property name="proportional_acc_max" value="$(arg proportional_acc_max)"/>        <!-- [0-254] -->

  <!-- Wheel geometry for omnidirectional control -->
  <xacro:property name="wheel_radius" value="0.051"/>  <!-- meters -->
  <xacro:property name="offset" value="${pi/3}"/>  <!-- 60° -->
  <xacro:property name="theta" value="${2*pi/3}"/>  <!-- 120° between wheels -->

  <!-- Maximum allowable speed/acceleration/torque for each motor -->
  <xacro:property name="max_velocity_steps" value="${int(sts3215_max_vel_steps * 0.85)}"/> <!-- steps/second (85% of hardware max, 15% safety margin) -->
  <xacro:property name="max_velocity_rads" value="${max_velocity_steps*2*pi/4096}"/> <!-- rad/s -->
  <xacro:property name="max_torque_nm" value="2.942"/> <!-- N⋅m (30 kgf⋅cm for STS3215) -->

  <!-- Omnidirectional Kinematics Calculations -->
  <!-- For 3-wheel omni drive: ω_i = (-sin(θ_i)·v_x + cos(θ_i)·v_y + R·ω_z) / r -->

  <!-- Maximum allowable linear velocity per axis -->
  <xacro:property name="max_linear_velocity_x" value="${wheel_radius * max_velocity_rads / (sqrt(3)/2)}"/>
  <xacro:property name="max_linear_velocity_y" value="${wheel_radius * max_velocity_rads / 1.0}"/>
  <xacro:property name="max_angular_velocity_z" value="${wheel_radius * max_velocity_rads / wheel_base_radius}"/>

  <!-- Duplicates pt_description's own promoted property (not included here - base_pantilt
       uses its own copy of the pantilt control block) for pantilt.module.xacro's gazebo limit. -->
  <xacro:property name="pantilt_max_velocity_steps" value="${int(sts3215_max_vel_steps * 0.85)}"/>
  <xacro:property name="pantilt_max_velocity_rads"  value="${pantilt_max_velocity_steps * 2 * pi / 4096}"/>

  <xacro:include filename="$(find pt_description)/urdf/pantilt.joints.xacro"/>

  <!-- ROS 2 CONTROL -->
  <!-- System interface — all STS3215 joints on a single serial bus -->
  <ros2_control name="lekiwi_base" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mujoco'}">
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg mujoco_headless)</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
        <!-- Serial communication parameters -->
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="use_sync_write">$(arg use_sync_write)</param>
        <param name="enable_mock_mode">$(arg use_mock)</param>
        <!-- Proportional ACC: scale per-wheel acceleration so all wheels finish ramping in equal time -->
        <param name="proportional_acc_max">${proportional_acc_max}</param>
        <!-- Proportional VEL: scale per-joint speed so all position joints arrive simultaneously -->
        <param name="proportional_vel_max">$(arg proportional_vel_max)</param>
      </xacro:if>
    </hardware>
    <!-- Left wheel joint (Motor ID 7) -->
    <joint name="left_wheel_joint">
      <param name="motor_id">$(arg left_motor_id)</param>
      <param name="operating_mode">${base_operating_mode}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts3215_max_vel_steps}</param>
      <param name="internal_max_vel">$(arg internal_max_vel)</param>
      <param name="internal_max_acc">$(arg internal_max_acc)</param>
      <param name="internal_acc_coeff">$(arg internal_acc_coeff)</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- Real-hardware-only telemetry - sim plugins have nothing beyond position/velocity/effort. -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>
    <!-- Back wheel joint (Motor ID 8) -->
    <joint name="back_wheel_joint">
      <param name="motor_id">$(arg back_motor_id)</param>
      <param name="operating_mode">${base_operating_mode}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts3215_max_vel_steps}</param>
      <param name="internal_max_vel">$(arg internal_max_vel)</param>
      <param name="internal_max_acc">$(arg internal_max_acc)</param>
      <param name="internal_acc_coeff">$(arg internal_acc_coeff)</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- Real-hardware-only telemetry - sim plugins have nothing beyond position/velocity/effort. -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>
    <!-- Right wheel joint (Motor ID 9) -->
    <joint name="right_wheel_joint">
      <param name="motor_id">$(arg right_motor_id)</param>
      <param name="operating_mode">${base_operating_mode}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts3215_max_vel_steps}</param>
      <param name="internal_max_vel">$(arg internal_max_vel)</param>
      <param name="internal_max_acc">$(arg internal_max_acc)</param>
      <param name="internal_acc_coeff">$(arg internal_acc_coeff)</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- Real-hardware-only telemetry - sim plugins have nothing beyond position/velocity/effort. -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>
    <xacro:pantilt_joints
        sts3215_max_vel_steps="${sts3215_max_vel_steps}"
        ros2_control_hardware_type="$(arg ros2_control_hardware_type)"/>

    <!-- IMU/lidar sensors must live in this SAME <ros2_control> block as the plugin above -
         see base.control.xacro (base-only) for why. -->
    <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mujoco'}">
      <!-- mujoco_type=imu maps to base_subtree.xml's bno055_quat/gyro/accel MJCF sensors -
           same state_interfaces as the real block below, gated on imu:=true. -->
      <xacro:if value="${'$(arg imu)' == 'true'}">
        <sensor name="bno055">
          <param name="mujoco_type">imu</param>
          <state_interface name="orientation.x"/>
          <state_interface name="orientation.y"/>
          <state_interface name="orientation.z"/>
          <state_interface name="orientation.w"/>
          <state_interface name="angular_velocity.x"/>
          <state_interface name="angular_velocity.y"/>
          <state_interface name="angular_velocity.z"/>
          <state_interface name="linear_acceleration.x"/>
          <state_interface name="linear_acceleration.y"/>
          <state_interface name="linear_acceleration.z"/>
        </sensor>
      </xacro:if>
      <!-- Matched to base_subtree.xml's MJCF sensors by name ("lidar") - see base.control.xacro. -->
      <sensor name="lidar">
        <param name="frame_name">laser_frame</param>
        <param name="min_angle">0.0</param>
        <param name="max_angle">6.274458660919615</param>
        <param name="angle_increment">0.017453292519943295</param>
        <param name="range_min">0.02</param>
        <param name="range_max">12.0</param>
        <param name="laserscan_topic">/scan</param>
      </sensor>
    </xacro:if>
  </ros2_control>

  <!-- ROS 2 CONTROL -->
  <!-- Real hardware only - gazebo bridges its own IMU sensor instead (base.module.xacro),
       mujoco hosts its sensor inside lekiwi_base above; also omitted when imu:=false. -->
  <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real' and '$(arg imu)' == 'true'}">
    <ros2_control name="lekiwi_imu" type="sensor">
      <hardware>
        <plugin>bno055_hardware_interface/BNO055HardwareInterface</plugin>
        <param name="i2c_bus">$(arg imu_i2c_bus)</param>       <!-- I2C bus number (default: 1 → /dev/i2c-1) -->
        <param name="i2c_addr">$(arg imu_i2c_addr)</param>     <!-- I2C address in hex, no 0x prefix (default: 28 = 0x28) -->
        <param name="axis_remap">$(arg imu_axis_remap)</param> <!-- Axis placement config: P0-P7 (default: P1) -->
        <param name="sensor_mode">$(arg imu_sensor_mode)</param> <!-- Fusion mode: NDOF, NDOF_FMC_OFF, IMUPLUS (default: NDOF) -->
        <param name="enable_mock_mode">$(arg use_mock)</param>  <!-- Reuse the system-level mock flag -->
      </hardware>
      <sensor name="bno055">
        <!-- Orientation (quaternion, unit norm) -->
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <!-- Angular velocity (rad/s) -->
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <!-- Linear acceleration (m/s²), gravity-compensated -->
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:if>

</robot>
