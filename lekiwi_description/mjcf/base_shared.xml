  <contact>
    <!-- Wheel collision geoms overlap the chassis collision cylinder at the mount point. -->
    <exclude body1="base_link" body2="left_wheel_link"/>
    <exclude body1="base_link" body2="back_wheel_link"/>
    <exclude body1="base_link" body2="right_wheel_link"/>
  </contact>

  <!-- Standalone-viewing scene dressing, gated on the scene arg. Compares $(arg scene)
       directly rather than via a bridged <xacro:property> - xacro auto-coerces "true"/"false"
       property values to Python bool, breaking a naive string comparison. Floor collides
       (unlike pt_description's) since the wheels rest and roll on it. -->
  <xacro:if value="${'$(arg scene)' == 'true'}">
    <statistic center="0 0 0.15" extent="0.7"/>

    <visual>
      <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global azimuth="45" elevation="-20"/>
    </visual>

    <asset>
      <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
      <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
      <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
      <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
      <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.4 0.005 0.0001"/>
    </worldbody>
  </xacro:if>

</mujoco>
