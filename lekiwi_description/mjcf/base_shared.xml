<!-- Payload-independent MJCF content shared by every base*.mjcf.xacro: compiler options,
     default classes, materials, wheel actuators, the IMU/lidar <sensor> block (sites/bodies
     defined in base_subtree.xml), and the optional standalone-viewing scene. Must be
     xacro:include'd, not a plain <include>, since $(arg scene) needs resolving. -->
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro" model="lekiwi_shared">
  <xacro:arg name="scene" default="true"/>

  <compiler angle="radian"/>

  <default>
    <default class="lekiwi_base">
      <default class="wheel">
        <!-- STS3215 dynamics, same defaults used for the pan/tilt joints in
             pt_description/mjcf/pantilt_shared.xml (same motor family, this project-wide). -->
        <joint type="hinge" axis="0 0 1" frictionloss="0.1" armature="0.1"/>
      </default>
      <default class="wheel_geom">
        <!-- Omni-wheel roller slip isn't modeled per-axis in MuJoCo; uses low isotropic
             friction instead and lets the controller's omni-kinematics dominate motion.
             See README Simulation section for validated behavior/error bounds. group="3" +
             the transparent material keep this collision primitive from visually competing
             with the real omni_wheel_visual mesh sitting in the same place (base_visual
             class, group="2") - same convention as pt_description/mjcf/pantilt_shared.xml's
             "collision" class. -->
        <geom type="cylinder" size="0.051 0.02125" friction="0.4 0.005 0.0001" group="3" material="base_transparent"/>
      </default>
      <default class="marker">
        <!-- Non-colliding visual meshes for laser_link/imu_link - real sensor behavior comes
             from the sites/sensors below, not these geoms. type="mesh" is required here: a
             geom's type does NOT default to "mesh" just because a mesh= attribute is given -
             it silently defaults to "sphere" (auto-sized from the mesh's bounding radius),
             discarding the actual mesh shape entirely. -->
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="base_visual">
        <!-- Non-colliding decimated meshes for base_link/wheels - the base_link_collision/
             wheel_*_collision cylinder primitives (base_subtree.xml) still do the actual
             physics; these are visual-only siblings. See lekiwi_base_mujoco.stl/
             omni_wheel_mujoco.stl comments below for why decimated copies exist at all. -->
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="base_light_grey" rgba="0.8 0.8 0.8 1.0"/>
    <material name="base_charcoal" rgba="0.15 0.15 0.15 1.0"/>
    <!-- Matches pt_description/mjcf/pantilt_shared.xml's "transparent" material - same
         purpose, kept as a separate asset since MuJoCo assets are namespaced per-model and
         this file's own "transparent" needs to exist independently of pantilt's. -->
    <material name="base_transparent" rgba="1 0 0 0.3"/>
    <!-- Well under MuJoCo's 200000-face STL limit (ld06_lidar: ~12428, bno055_imu: ~34048). -->
    <mesh name="ld06_lidar" file="$(find lekiwi_description)/meshes/ld06_lidar.stl"/>
    <mesh name="bno055_imu" file="$(find lekiwi_description)/meshes/bno055_imu.stl"/>
    <!-- lekiwi_base.stl (739500 faces) and omni_wheel.stl (543010 faces) both exceed
         MuJoCo's 200000-face STL limit outright. These are quadric-decimated copies kept
         alongside the full-resolution originals - decimation quality verified by comparing
         convex-hull volume before/after. base: pymeshlab (boundary/normal/topology-
         preserving quadric edge collapse), 150k faces, ~0.03% volume delta - fast-
         simplification's defaults were noticeably worse quality at a similar face count
         (~5.5% delta at 100k) despite matching bounding-box extent. wheel: fast-
         simplification, 40k faces, ~1.3% volume delta - not yet revisited with pymeshlab.
         Visual only - collision still uses the cylinder primitives below, unchanged. -->
    <mesh name="lekiwi_base_visual" file="$(find lekiwi_description)/meshes/lekiwi_base_mujoco.stl"/>
    <mesh name="omni_wheel_visual" file="$(find lekiwi_description)/meshes/omni_wheel_mujoco.stl"/>
  </asset>

  <actuator>
    <!-- Velocity-mode, matching base_controller/STS3215 (operating_mode=1). kv is an
         initial value, not yet cross-checked against real hardware. -->
    <velocity name="left_wheel_joint" joint="left_wheel_joint" kv="5" forcerange="-2.942 2.942"/>
    <velocity name="back_wheel_joint" joint="back_wheel_joint" kv="5" forcerange="-2.942 2.942"/>
    <velocity name="right_wheel_joint" joint="right_wheel_joint" kv="5" forcerange="-2.942 2.942"/>
  </actuator>

  <sensor>
    <!-- BNO055 IMU. Names follow mujoco_ros2_control's required _quat/_gyro/_accel suffix
         convention (see base.control.xacro's mujoco_type="imu" param). -->
    <framequat name="bno055_quat" objtype="site" objname="imu_site"/>
    <gyro name="bno055_gyro" site="imu_site"/>
    <accelerometer name="bno055_accel" site="imu_site"/>

