<!-- base_link's direct children as an includable fragment (freejoint, chassis collision,
     3 wheels, laser_link, imu_link), meant to be spliced inside a <body name="base_link">
     opened by the includer. Not a standalone model - never loaded directly. Body
     pos/euler/quat values are ported from urdf/base/base.module.xacro + base.common.xacro. -->
<mujoco>
  <!-- 6-DOF floating base - rests on the 3 wheels under gravity, not fixed to anything. -->
  <freejoint/>
  <inertial pos="0 0 0" mass="2.0" diaginertia="0.01 0.01 0.02"/>
  <!-- Collision cylinder approximates the chassis footprint - the real mesh (739500
       triangles) exceeds MuJoCo's 200000-face STL loader limit. -->
  <geom name="base_link_collision" type="cylinder" size="0.108 0.0575" pos="0 0 0.05025" material="base_light_grey"/>

  <!-- Wheel orientation is an explicit quat, not euler="0 pi/2 <yaw>" - MuJoCo's eulerseq
       doesn't compose the same way URDF's rpy does, which previously put every wheel's
       rotation axis on the same fixed direction regardless of yaw (confirmed empirically).
       quat = q_z(mount_angle) ⊗ q_y(90°), mount_angle = pi/3 (matches base.control.xacro's
       "offset" property). -->
  <body name="left_wheel_link" pos="0.066120 0.114522 0.010360" quat="0.61237244 -0.35355339 0.61237244 0.35355339">
    <joint name="left_wheel_joint" class="wheel"/>
    <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
    <geom name="left_wheel_collision" class="wheel_geom" material="base_charcoal"/>
  </body>
  <body name="back_wheel_link" pos="-0.132239 0.000000 0.010360" quat="0.00000000 -0.70710678 0.00000000 0.70710678">
    <joint name="back_wheel_joint" class="wheel"/>
    <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
    <geom name="back_wheel_collision" class="wheel_geom" material="base_charcoal"/>
  </body>
  <body name="right_wheel_link" pos="0.066120 -0.114522 0.010360" quat="0.61237244 0.35355339 0.61237244 -0.35355339">
    <joint name="right_wheel_joint" class="wheel"/>
    <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
    <geom name="right_wheel_collision" class="wheel_geom" material="base_charcoal"/>
  </body>

  <!-- laser_link + laser_frame (base.module.xacro), matching ldlidar_ros2_node's frame. -->
  <body name="laser_link" pos="-0.045042 0 0.091500">
    <!-- euler matches base.module.xacro's laser_offset_rx (pi/2 about X) - safe to port
         directly since it's a single-axis rotation, unlike pantilt's multi-axis meshes. -->
    <geom class="marker" mesh="ld06_lidar" material="base_charcoal" euler="1.5707963267948966 0 0"/>
    <body name="laser_frame" pos="0 0 0.027000">
      <!-- 360 rangefinders at 1 deg resolution (real LD19: 452/rev, ~0.797 deg - reduced
           for a clean integer sweep count). Each site's quat sweeps local +Z CCW about
