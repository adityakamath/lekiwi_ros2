<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_description</name>
  <version>0.1.0</version>
  <description>URDF, meshes, and robot description for LeKiwi robot</description>
  <author email="adityakamath@live.com">Aditya Kamath</author>
  <maintainer email="adityakamath@live.com">Aditya Kamath (Kamath Robotics)</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/adityakamath/lekiwi_ros2</url>
  <url type="repository">https://github.com/adityakamath/lekiwi_ros2</url>
  <url type="bugtracker">https://github.com/adityakamath/lekiwi_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>pt_description</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

