<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_control</name>
  <version>0.1.0</version>
  <description>High-level control nodes and diagnostics for LeKiwi robot</description>
  <author email="adityakamath@live.com">Aditya Kamath</author>
  <maintainer email="adityakamath@live.com">Aditya Kamath (Kamath Robotics)</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/adityakamath/lekiwi_ros2</url>
  <url type="repository">https://github.com/adityakamath/lekiwi_ros2</url>
  <url type="bugtracker">https://github.com/adityakamath/lekiwi_ros2/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <!-- Launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lekiwi_description</exec_depend>
  <exec_depend>lekiwi_mujoco</exec_depend>
  <exec_depend>pt_control</exec_depend>
  <exec_depend>pt_mujoco</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>omni_wheel_drive_controller</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>sts_hardware_interface</exec_depend>
  <exec_depend>bno055_hardware_interface</exec_depend>
  <!-- Simulation only (sim:=true) -->
  <exec_depend>mujoco_ros2_control</exec_depend>
  <!-- Plugins and filters used in simulation -->
  <exec_depend>mujoco_ros2_control_plugins</exec_depend>
  <exec_depend>mujoco_3d_lidar</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>service_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
