<?xml version="1.0"?>
<package format="3">
  <name>lekiwi_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo models, scene composition and a standalone viewer for LeKiwi (no ROS runtime required)</description>
  <maintainer email="adityakamath@live.com">Aditya Kamath (Kamath Robotics)</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>lekiwi_description</exec_depend>
  <exec_depend>pt_description</exec_depend>
  <exec_depend>pt_mujoco</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- The mujoco and glfw Python packages come from pip (requirements.txt), not rosdep. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
