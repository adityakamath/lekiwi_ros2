<mujoco model="lekiwi_arena">
    <!-- Flat floor inside a 6 x 6 m walled room with a few obstacles, for navigation tests. -->
    <statistic center="0 0 0.15" extent="0.7"/>

    <visual>
      <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global azimuth="135" elevation="-25" offwidth="1280" offheight="720"/>
    </visual>

    <asset>
      <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
      <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
      <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
      <material name="wall" rgba="0.75 0.72 0.65 1"/>
      <material name="obstacle" rgba="0.85 0.45 0.2 1"/>
    </asset>

    <worldbody>
      <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
      <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.4 0.005 0.0001"/>
      <geom name="wall_north" type="box" size="3 0.05 0.4" pos="0 3 0.4" material="wall"/>
      <geom name="wall_south" type="box" size="3 0.05 0.4" pos="0 -3 0.4" material="wall"/>
      <geom name="wall_east" type="box" size="0.05 3 0.4" pos="3 0 0.4" material="wall"/>
      <geom name="wall_west" type="box" size="0.05 3 0.4" pos="-3 0 0.4" material="wall"/>
      <geom name="box_a" type="box" size="0.3 0.3 0.25" pos="1.5 0.8 0.25" material="obstacle"/>
      <geom name="box_b" type="box" size="0.2 0.5 0.25" pos="-1.2 -1.0 0.25" material="obstacle"/>
      <geom name="pillar" type="cylinder" size="0.2 0.4" pos="0.5 -1.8 0.4" material="obstacle"/>
    </worldbody>

</mujoco>
